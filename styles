:root {
    --bg-primary: #09090B;
    --bg-secondary: #111114;
    --bg-card: #16161A;
    --gold: #C6A355;
    --gold-light: #DFC27D;
    --text-primary: #F5F5F7;
    --text-secondary: #A1A1AA;
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-gold: rgba(198, 163, 85, 0.35);
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    --transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-primary);
    background-image: linear-gradient(to bottom, rgba(9, 9, 11, 0.78), rgba(9, 9, 11, 0.94)), url('sfondo.webp');
    background-size: cover;
    background-position: center top;
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

.container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 20px;
}

/* HEADER */
header {
    text-align: center;
    padding: 64px 0 44px;
    border-bottom: 1px solid var(--border-subtle);
}

.eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
}

.monogram {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    border: 1px solid var(--border-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 22px;
    letter-spacing: 0.1em;
    color: var(--gold);
    background: rgba(198, 163, 85, 0.04);
}

h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 14px;
}

.subtitle {
    font-size: 14px;
    font-weight: 300;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0 auto 32px;
}

/* BUTTONS */
.cta-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 460px;
    margin: 0 auto;
}

.btn-primary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 26px;
    background: linear-gradient(135deg, var(--gold) 0%, #B38E3E 100%);
    color: #09090B;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--gold-light);
    transition: var(--transition);
}

.btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-2px);
}

.social-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 16px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: var(--transition);
}

.btn-secondary:hover {
    border-color: var(--border-gold);
    color: var(--gold-light);
}

.btn-secondary svg, .btn-primary svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* SECTIONS */
section {
    padding: 52px 0;
    border-bottom: 1px solid var(--border-subtle);
}

.section-header {
    text-align: center;
    margin-bottom: 36px;
}

.section-tag {
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 8px;
}

h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    color: var(--text-primary);
}

/* PILLARS */
.pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.pillar {
    background-color: var(--bg-card);
    padding: 20px;
    border-radius: 8px;
}

/* RESPONSIVE */
@media (max-width: 768px) {
    .pillars-grid {
        grid-template-columns: 1fr;
    }

    h1 {
        font-size: 2rem;
    }

    .subtitle {
        font-size: 13px;
    }

    .btn-primary, .btn-secondary {
        font-size: 10px;
    }
}
